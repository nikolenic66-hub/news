# Required: use a separate Neon project for this bot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# DeepSeek API. Current model alias from official API docs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# RSS URLs separated by commas. Add/remove sources after checking their terms.
RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://feeds.theguardian.com/theguardian/football

# Schedule (Europe/Moscow by default). 10 is the hard maximum.
APP_TIMEZONE=Europe/Moscow
POLL_INTERVAL_MINUTES=15
MAX_POSTS_PER_DAY=10
PUBLISH_INTERVAL_MINUTES=90
PUBLISH_WINDOW_START_HOUR=8
PUBLISH_WINDOW_END_HOUR=23
MAX_NEWS_AGE_HOURS=36
MAX_ITEMS_TO_PROCESS_PER_CYCLE=5

# Photo search. Only Commons images with reusable licenses are accepted.
WIKIMEDIA_USER_AGENT=FootballNewsBot/0.1 (contact: configure-your-email@example.com)
MAX_PHOTO_ATTEMPTS=4
PHOTO_RETRY_HOURS=6
MAX_PHOTO_BYTES=9000000

LOG_LEVEL=INFO
