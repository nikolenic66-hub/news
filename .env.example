# SAFE DEFAULT: collects RSS links only. No DeepSeek calls and no Telegram posts.
# Choose "prepare" for AI drafting + licensed-image search, or "live" to publish.
APP_MODE=collect_only

# Required in all modes. Use a separate Neon project for this bot, not the manager DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Telegram is only required when APP_MODE=live.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# DeepSeek is required for prepare/live modes. Current official model alias as at 2026-10-29.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Hard spending guards. Prices below are conservative peak prices; revise if provider prices change.
MAX_DEEPSEEK_CALLS_PER_DAY=30
DEEPSEEK_DAILY_BUDGET_USD=0.08
DEEPSEEK_INPUT_PRICE_PER_MILLION_USD=0.30
DEEPSEEK_OUTPUT_PRICE_PER_MILLION_USD=1.20
DEEPSEEK_MAX_OUTPUT_TOKENS=700

# RSS URLs separated by commas. Review current terms before enabling a source.
RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss

# Schedule: Moscow time by default. 10 is the hard maximum.
APP_TIMEZONE=Europe/Moscow
POLL_INTERVAL_MINUTES=15
MAX_POSTS_PER_DAY=10
PUBLISH_INTERVAL_MINUTES=90
PUBLISH_WINDOW_START_HOUR=8
PUBLISH_WINDOW_END_HOUR=23
MAX_NEWS_AGE_HOURS=36
MAX_ITEMS_TO_PROCESS_PER_CYCLE=3

# Wikimedia Commons: set a truthful contact email in this User-Agent.
WIKIMEDIA_USER_AGENT=FootballNewsBot/0.1 (contact: replace-with-your-email@example.com)
MAX_PHOTO_ATTEMPTS=4
PHOTO_RETRY_HOURS=6
MAX_PHOTO_BYTES=9000000

LOG_LEVEL=INFO
